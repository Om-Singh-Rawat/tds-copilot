# Copy to .env and fill in. Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any OpenRouter model id; free models end in :free and change over time - check https://openrouter.ai/models?q=free
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
RETRIEVAL_TOP_K=5

# Web server (python -m tds serve)
HOST=127.0.0.1
PORT=8000
# 1 = public demo: hides the audit trail from visitors
TDS_PUBLIC=0
# 0 = never call the LLM, only replay cached answers (no spend, works without a key)
TDS_LIVE_LLM=1
# live LLM calls allowed per visitor IP per minute
TDS_LLM_RPM=6
